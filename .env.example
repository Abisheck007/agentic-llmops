
# Application
APP_NAME=Agentic RAG Platform
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-local-development-key
AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name
AZURE_OPENAI_API_VERSION=your-supported-api-version

# LLM settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000

# Azure AI Search - Phase 3
# AZURE_AI_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
# AZURE_AI_SEARCH_INDEX=your-index-name

APPLICATIONINSIGHTS_CONNECTION_STRING=your-application-insights-connection-string

# Frontend -> FastAPI backend
BACKEND_API_URL=http://127.0.0.1:8000